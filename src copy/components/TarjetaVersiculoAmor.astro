---
// Versículo 1 Corintios 13:4-8
---
<div class="tarjeta-versiculo-amor w-full">
  <div class="bg-white shadow-xl overflow-hidden">
    <div class="px-4 pt-6 pb-14 text-center">

      <div class="flex items-center gap-2 mb-3">
        <div class="flex-1 h-px bg-[#c8b194]"></div>
        <span class="text-[#c8b194] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]"></div>
      </div>

      <p class="font-cormorant text-base text-[#4d5441] leading-relaxed italic">
        “El amor es paciente, es bondadoso. Todo lo disculpa, todo lo cree,
        todo lo espera, todo lo soporta. El amor jamás se acaba.”
      </p>

      <div class="flex items-center gap-2 mt-3">
        <div class="flex-1 h-px bg-[#c8b194]"></div>
        <span class="text-[#c8b194] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]"></div>
      </div>

      <p class="font-cormorant text-sm text-[#c8b194] mt-2 uppercase tracking-wider">1 Corintios 13:4-8</p>

    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(".tarjeta-versiculo-amor",
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".tarjeta-versiculo-amor", start: "top 90%", toggleActions: "play none none reset" }
    }
  );
</script>
