---

---

<div class="tarjeta-ceremonia w-full">
  <div class="bg-[#4d5441] shadow-xl overflow-hidden">
    <div class="px-3 pt-6 pb-16 text-center">
      <h2 class="font-cormorant text-base text-[#c8b194] uppercase font-semibold leading-tight mb-0.5">
        Con la bendición de Dios
      </h2>
      <h2 class="font-cormorant text-base text-[#c8b194] uppercase font-semibold leading-tight mb-1">
        y acompañados del amor y apoyo de nuestros padres y padrinos
      </h2>

      <div class="flex items-center gap-2 mb-2">
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
        <span class="text-[#c8b194]/40 text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
      </div>

      <p class="font-cormorant text-sm text-[#c8b194]/80 uppercase mb-1">Madre del novio</p>
      <p class="font-cormorant text-sm text-white/90 leading-tight mb-3">Maria Elena Monasterio Zabala</p>

      <div class="flex items-center gap-2 mb-2">
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
        <span class="text-[#c8b194]/40 text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
      </div>

      <p class="font-cormorant text-sm text-[#c8b194]/80 uppercase mb-1">Padres de la novia</p>
      <p class="font-cormorant text-sm text-white/90 leading-tight">María Serrano Alarcón (+)</p>
      <p class="font-cormorant text-sm text-white/90 leading-tight mb-3">Alberto Mamani Gorostiaga</p>

      <div class="flex items-center gap-2 mb-2">
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
        <span class="text-[#c8b194]/40 text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
      </div>

      <p class="font-cormorant text-sm text-[#c8b194]/80 uppercase mb-1">Padrinos de religión</p>
      <p class="font-cormorant text-sm text-white/90 leading-tight">Sixto Teofilo Gutierrez Morales</p>
      <p class="font-cormorant text-sm text-white/90 leading-tight mb-3">Deysi Cama Butron</p>

      <div class="flex items-center gap-2 mb-2">
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
        <span class="text-[#c8b194]/40 text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]/25"></div>
      </div>

      <p class="font-cormorant text-sm text-[#c8b194]/80 uppercase mb-1">Padrinos de civil</p>
      <p class="font-cormorant text-sm text-white/90 leading-tight">Antonia Serrano Alarcón</p>
      <p class="font-cormorant text-sm text-white/90 leading-tight">Gabriel Cuéllar Vázquez</p>
    </div>
  </div>
</div>

<style>
  .dorado-filter {
    filter: brightness(0) saturate(100%) invert(73%) sepia(18%) saturate(500%)
      hue-rotate(345deg) brightness(102%) contrast(90%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(
    ".tarjeta-ceremonia",
    { opacity: 0, y: 40 },
    {
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".tarjeta-ceremonia",
        start: "top 90%",
        toggleActions: "play none none reset",
      },
    },
  );
</script>
