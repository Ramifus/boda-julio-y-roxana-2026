---
const TITULAR_QR = "Roxana Mamani Serrano";
const CUENTA_QR = "457553-000-002";
const CONCEPTO_QR = "Regalo de boda Julio y Roxana";
---
<div class="tarjeta-regalos w-full">
  <div class="bg-white shadow-xl overflow-hidden">
    <div class="px-3 py-6 text-center">

      <div class="flex justify-center mb-2">
        <img src="/iconos/lluvia-sobre.png" alt="Regalos" class="w-10 h-10 object-contain verde-filter" />
      </div>

      <h2 class="font-cormorant text-base text-[#c8b194] uppercase font-semibold leading-tight mb-1">Sugerencia de Regalo</h2>

      <div class="flex items-center gap-2 mb-2">
        <div class="flex-1 h-px bg-[#c8b194]"></div>
        <span class="text-[#c8b194] text-[10px]">✦</span>
        <div class="flex-1 h-px bg-[#c8b194]"></div>
      </div>

      <p class="font-cormorant text-sm text-[#4d5441] leading-tight mb-2">Su presencia y sus buenos deseos son nuestro mejor regalo. Si desean hacernos llegar algún presente estaremos muy agradecidos. Gracias por tu muestra de cariño.</p>

      <!-- QR ancho completo -->
      <div class="w-full mb-2 overflow-hidden border border-[#c8b194]/40">
        <img src="/imagenes/qr.png" alt="QR" class="w-full object-contain"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"/>
        <div class="hidden w-full h-24 items-center justify-center bg-[#f5f0e8]">
          <p class="font-cormorant text-xs text-[#c8b194]/60">QR</p>
        </div>
      </div>

      <p class="font-cormorant text-sm text-[#c8b194] font-semibold leading-snug mt-1">{TITULAR_QR}</p>
      <p class="font-cormorant text-sm text-[#4d5441] leading-snug mt-1.5">Cuenta Nº <span class="numero-cuenta">{CUENTA_QR}</span></p>
      <p class="font-cormorant text-sm text-[#4d5441] italic leading-snug mt-1.5">Concepto: {CONCEPTO_QR}</p>

    </div>
  </div>
</div>

<style>
  /* Cifras altas para que el número de cuenta se lea parejo */
  .numero-cuenta {
    font-variant-numeric: lining-nums;
    font-feature-settings: "lnum" 1;
  }
  .verde-filter {
    filter: brightness(0) saturate(100%) invert(29%) sepia(30%) saturate(600%) hue-rotate(115deg) brightness(80%) contrast(90%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(".tarjeta-regalos",
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".tarjeta-regalos", start: "top 90%", toggleActions: "play none none reset" }
    }
  );
</script>
