---
// Tarjeta de lugar (ceremonia o recepción). Se usa una vez por cada lugar.
interface Props {
  /** Título en dos renglones: ["Ceremonia", "Religiosa"] */
  titulo: [string, string];
  lugar: string;
  direccion: string;
  hora: string;
  ubicacion: string;
  icono: string;
  /** De qué lado asoman las hojas decorativas */
  hojas?: "izq" | "der";
}

const { titulo, lugar, direccion, hora, ubicacion, icono, hojas = "der" } = Astro.props;
---
<div class="tarjeta-recepcion w-full relative">
  <img
    src="/imagenes/hojaslateral.png"
    alt="Hojas decorativas"
    class:list={[
      "absolute -top-10 w-[90px] object-contain z-0",
      hojas === "der" ? "-right-8" : "-left-8",
    ]}
    style={hojas === "der" ? "transform: scaleX(-1);" : undefined}
  />
  <div class="bg-[#f5f0e8] shadow-xl overflow-hidden relative z-10" style="border-radius: 90px 90px 0 0;">
    <div class="px-3 pt-8 pb-12 text-center">

      <h2 class="font-cormorant text-base text-[#c8b194] uppercase font-semibold leading-tight mb-0.5">
        {titulo[0]}
      </h2>
      <h2 class="font-cormorant text-base text-[#c8b194] uppercase font-semibold leading-tight mb-2">
        {titulo[1]}
      </h2>

      <div class="flex justify-center mb-2">
        <img src={icono} alt={`${titulo[0]} ${titulo[1]}`} class="w-10 h-10 object-contain verde-filter" />
      </div>

      <p class="font-crimson text-base text-[#c8b194] font-semibold leading-tight mb-2">{hora}</p>

      <p class="font-cormorant text-base text-[#c8b194] font-semibold leading-tight mb-1" set:html={lugar} />

      <p class="font-cormorant text-base text-[#4d5441] leading-snug mb-3">{direccion}</p>

      <a href={ubicacion} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-[#4d5441] text-[#c8b194] font-cormorant text-xs uppercase px-6 py-2 rounded-full hover:bg-[#4d5441]/90 transition-colors">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Ubicación
      </a>

    </div>
  </div>
</div>

<style>
  .verde-filter {
    filter: brightness(0) saturate(100%) invert(29%) sepia(30%) saturate(600%) hue-rotate(115deg) brightness(80%) contrast(90%);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  // Hay una tarjeta por lugar: cada una se anima cuando ella entra en pantalla
  document.querySelectorAll(".tarjeta-recepcion").forEach((tarjeta) => {
    gsap.fromTo(tarjeta,
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1, ease: "power3.out",
        scrollTrigger: { trigger: tarjeta, start: "top 90%", toggleActions: "play none none reset" }
      }
    );
  });
</script>
